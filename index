<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>PONG — Ekran</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Space+Mono:wght@400;700&display=swap');

  :root{
    --phosphor: #35FF6E;
    --phosphor-dim: #1B7A38;
    --bg: #050807;
    --bg2: #0A120D;
    --amber: #FFB000;
    --line: rgba(53,255,110,0.18);
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html,body{height:100%;}
  body{
    background:var(--bg); color:var(--phosphor); font-family:'Space Mono', monospace;
    min-height:100vh; display:flex; flex-direction:column; align-items:center;
    overflow-x:hidden; position:relative;
  }
  body::before{
    content:""; position:fixed; inset:0;
    background:repeating-linear-gradient(to bottom, rgba(0,0,0,0) 0px, rgba(0,0,0,0) 2px, rgba(0,0,0,0.18) 3px, rgba(0,0,0,0.18) 3px);
    pointer-events:none; z-index:50; mix-blend-mode:multiply;
  }
  body::after{
    content:""; position:fixed; inset:0;
    background:radial-gradient(ellipse at center, rgba(0,0,0,0) 55%, rgba(0,0,0,0.65) 100%);
    pointer-events:none; z-index:51;
  }

  header{ width:100%; max-width:920px; padding:22px 20px 8px; text-align:center; }
  .logo{ font-family:'Press Start 2P', monospace; font-size:22px; letter-spacing:2px; text-shadow:0 0 6px var(--phosphor), 0 0 18px rgba(53,255,110,0.5); }
  .logo span{ color:var(--amber); text-shadow:0 0 6px var(--amber), 0 0 18px rgba(255,176,0,0.5); }
  .subtitle{ font-size:12px; color:var(--phosphor-dim); letter-spacing:1px; margin-top:6px; }

  main{ width:100%; max-width:920px; padding:16px 20px 40px; display:flex; flex-direction:column; align-items:center; gap:18px; }

  .scoreboard{
    font-family:'Press Start 2P', monospace; font-size:clamp(28px, 6vw, 46px);
    display:flex; align-items:center; gap:28px; text-shadow:0 0 10px currentColor;
  }
  .scoreboard .you{ color:var(--phosphor); }
  .scoreboard .cpu{ color:var(--amber); }
  .scoreboard .sep{ color:var(--phosphor-dim); font-size:0.6em; }
  .score-labels{ display:flex; justify-content:space-between; width:100%; max-width:520px; font-size:10px; color:var(--phosphor-dim); letter-spacing:2px; margin-top:-10px; }

  #gameWrap{
    position:relative; width:100%; max-width:720px; aspect-ratio: 4 / 3;
    border:2px solid var(--phosphor-dim); border-radius:6px;
    box-shadow:0 0 30px rgba(53,255,110,0.08) inset, 0 0 40px rgba(53,255,110,0.06);
    background:linear-gradient(var(--bg2), var(--bg2)) padding-box;
    overflow:hidden;
  }
  canvas{ display:block; width:100%; height:100%; }

  #overlayMsg{
    position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center;
    gap:16px; text-align:center; background:rgba(5,8,7,0.92);
    font-family:'Press Start 2P', monospace; font-size:14px; letter-spacing:1px; padding:24px; z-index:5;
  }
  #overlayMsg .small{ font-family:'Space Mono', monospace; font-size:12px; color:var(--phosphor-dim); letter-spacing:0.5px; max-width:400px; line-height:1.7; }
  #overlayMsg.hidden{ display:none; }

  #qrBox{ background:#EAFFF0; padding:14px; border-radius:8px; box-shadow:0 0 24px rgba(53,255,110,0.35); }
  #qrBox img, #qrBox canvas{ display:block; }
  .code-text{ font-family:'Space Mono', monospace; font-size:11px; letter-spacing:1px; color:var(--phosphor-dim); word-break:break-all; max-width:340px; }

  .status-row{ display:flex; align-items:center; gap:8px; font-size:11px; letter-spacing:0.5px; }
  .dot{ width:9px; height:9px; border-radius:50%; background:#555; flex-shrink:0; }
  .dot.waiting{ background:var(--amber); box-shadow:0 0 8px var(--amber); animation:pulse 1s infinite; }
  .dot.connected{ background:var(--phosphor); box-shadow:0 0 8px var(--phosphor); }
  @keyframes pulse{ 0%,100%{opacity:1;} 50%{opacity:0.35;} }

  button{
    font-family:'Press Start 2P', monospace; font-size:11px; letter-spacing:1px;
    background:transparent; color:var(--phosphor); border:2px solid var(--phosphor);
    padding:12px 22px; border-radius:4px; cursor:pointer;
    text-shadow:0 0 6px var(--phosphor); box-shadow:0 0 10px rgba(53,255,110,0.15);
    transition:all .15s;
  }
  button:hover{ background:rgba(53,255,110,0.1); }
  button:disabled{ opacity:0.3; cursor:not-allowed; }

  .controls-panel{
    width:100%; max-width:720px; display:grid; grid-template-columns:1fr 1fr; gap:14px;
    padding:16px; border:1px solid var(--line); border-radius:8px; background:rgba(53,255,110,0.02);
  }
  @media (max-width:520px){ .controls-panel{ grid-template-columns:1fr; } }
  .ctrl-group{ display:flex; flex-direction:column; gap:6px; }
  .ctrl-group label{ font-size:10px; letter-spacing:0.5px; color:var(--phosphor-dim); display:flex; justify-content:space-between; }
  input[type=range]{ -webkit-appearance:none; width:100%; height:4px; border-radius:2px; background:var(--phosphor-dim); outline:none; }
  input[type=range]::-webkit-slider-thumb{ -webkit-appearance:none; width:14px; height:14px; border-radius:50%; background:var(--phosphor); box-shadow:0 0 6px var(--phosphor); cursor:pointer; }
  .difficulty-row{ display:flex; gap:6px; }
  .diff-btn{ flex:1; font-size:9px; padding:8px 4px; border:1px solid var(--phosphor-dim); color:var(--phosphor-dim); background:transparent; border-radius:4px; }
  .diff-btn.active{ color:var(--phosphor); border-color:var(--phosphor); box-shadow:0 0 8px rgba(53,255,110,0.25); }

  footer{ width:100%; max-width:720px; padding:0 20px 30px; font-size:10.5px; line-height:1.7; color:var(--phosphor-dim); text-align:center; }
  footer b{ color:var(--phosphor); }
</style>
</head>
<body>

<header>
  <div class="logo"><span>PONG</span></div>
  <div class="subtitle">zeskanuj kod QR telefonem, żeby zostać kontrolerem</div>
</header>

<main>

  <div>
    <div class="scoreboard">
      <span class="you" id="scoreYou">0</span>
      <span class="sep">:</span>
      <span class="cpu" id="scoreCpu">0</span>
    </div>
    <div class="score-labels"><span>GRACZ</span><span>CPU</span></div>
  </div>

  <div id="gameWrap">
    <canvas id="game"></canvas>
    <div id="overlayMsg">
      <div id="overlayTitle">ZESKANUJ, ŻEBY DOŁĄCZYĆ</div>
      <div id="qrBox"><div id="qrCanvas"></div></div>
      <div class="status-row"><div class="dot waiting" id="dot"></div><span id="statusLabel">Czekam na telefon…</span></div>
      <button id="btnStart" disabled>Start</button>
    </div>
  </div>

  <div class="controls-panel">
    <div class="ctrl-group">
      <label>Prędkość piłki <span id="speedVal">1.0x</span></label>
      <input type="range" id="speed" min="0.6" max="1.8" step="0.1" value="1.0">
    </div>
    <div class="ctrl-group">
      <label>Poziom CPU</label>
      <div class="difficulty-row">
        <button class="diff-btn" data-d="0.5">ŁATWY</button>
        <button class="diff-btn active" data-d="0.75">ŚREDNI</button>
        <button class="diff-btn" data-d="1.0">TRUDNY</button>
      </div>
    </div>
  </div>

  <footer>
    Gra do <b>7 punktów</b>. Ekran łączy się z telefonem bezpośrednio (WebRTC) — obie strony muszą mieć internet, ale sama rozgrywka nie przechodzi przez żaden Twój serwer.
  </footer>

</main>

<script src="https://cdnjs.cloudflare.com/ajax/libs/peerjs/1.5.4/peerjs.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
(() => {
  const $ = id => document.getElementById(id);
  const el = {
    speed: $('speed'), speedVal: $('speedVal'),
    overlay: $('overlayMsg'), overlayTitle: $('overlayTitle'), btnStart: $('btnStart'),
    dot: $('dot'), statusLabel: $('statusLabel'), qrCanvas: $('qrCanvas'),
    scoreYou: $('scoreYou'), scoreCpu: $('scoreCpu'), canvas: $('game')
  };

  function hideOverlay(){ el.overlay.classList.add('hidden'); }
  function showOverlay(){ el.overlay.classList.remove('hidden'); }

  el.speed.addEventListener('input', () => { state.speedMult = parseFloat(el.speed.value); el.speedVal.textContent = state.speedMult.toFixed(1)+'x'; });
  document.querySelectorAll('.diff-btn').forEach(b => {
    b.addEventListener('click', () => {
      document.querySelectorAll('.diff-btn').forEach(x=>x.classList.remove('active'));
      b.classList.add('active');
      state.cpuLevel = parseFloat(b.dataset.d);
    });
  });

  // ---- WebRTC (PeerJS) — telefon łączy się z tym ekranem ----
  let inputUp = false, inputDown = false, controllerConnected = false;

  const peer = new Peer();
  peer.on('open', (id) => {
    const url = new URL('controller.html', window.location.href);
    url.searchParams.set('code', id);
    new QRCode(el.qrCanvas, { text: url.toString(), width: 200, height: 200, colorDark:'#0A120D', colorLight:'#EAFFF0' });
  });
  peer.on('error', (err) => {
    el.statusLabel.textContent = 'Błąd połączenia: ' + err.type;
  });
  peer.on('connection', (conn) => {
    conn.on('open', () => {
      controllerConnected = true;
      el.dot.className = 'dot connected';
      el.statusLabel.textContent = 'Telefon połączony';
      el.btnStart.disabled = false;
    });
    conn.on('data', (data) => {
      if (data && data.type === 'input'){
        inputUp = !!data.up;
        inputDown = !!data.down;
      }
    });
    conn.on('close', () => {
      controllerConnected = false;
      el.dot.className = 'dot waiting';
      el.statusLabel.textContent = 'Telefon rozłączony — odśwież stronę, żeby połączyć ponownie';
      el.btnStart.disabled = true;
    });
  });

  el.btnStart.addEventListener('click', () => {
    hideOverlay();
    state.youScore = 0; state.cpuScore = 0;
    el.scoreYou.textContent = 0; el.scoreCpu.textContent = 0;
    state.running = true;
    resetBall();
  });

  // ---- Gra: Pong ----
  const ctx = el.canvas.getContext('2d');
  const W = 640, H = 480;
  el.canvas.width = W; el.canvas.height = H;

  const state = {
    speedMult: 1.0, cpuLevel: 0.75,
    youY: H/2, cpuY: H/2, paddleH: 90, paddleW: 12,
    ballX: W/2, ballY: H/2, ballVX: 0, ballVY: 0,
    youScore: 0, cpuScore: 0, running: false
  };

  function resetBall(dir){
    state.ballX = W/2; state.ballY = H/2;
    const angle = (Math.random()*0.6 - 0.3);
    const d = dir || (Math.random() < 0.5 ? -1 : 1);
    const base = 4.2 * state.speedMult;
    state.ballVX = d * base * Math.cos(angle);
    state.ballVY = base * Math.sin(angle);
  }

  function updateYouPaddle(){
    const paddleRange = H - state.paddleH;
    const spd = 7;
    if (inputUp) state.youY -= spd;
    if (inputDown) state.youY += spd;
    state.youY = Math.max(0, Math.min(paddleRange, state.youY));
  }

  function updateCpuPaddle(){
    const center = state.cpuY + state.paddleH/2;
    const targetY = state.ballY;
    const speed = 4.2 * state.cpuLevel + 1.2;
    if (Math.abs(center - targetY) > 6){
      state.cpuY += (center < targetY ? 1 : -1) * speed;
    }
    state.cpuY = Math.max(0, Math.min(H - state.paddleH, state.cpuY));
  }

  function updateBall(){
    if (!state.running) return;
    state.ballX += state.ballVX;
    state.ballY += state.ballVY;

    if (state.ballY <= 6 || state.ballY >= H-6){
      state.ballVY *= -1;
      state.ballY = Math.max(6, Math.min(H-6, state.ballY));
    }
    if (state.ballX <= 26 + state.paddleW && state.ballX > 20 &&
        state.ballY > state.youY && state.ballY < state.youY + state.paddleH && state.ballVX < 0){
      const rel = (state.ballY - (state.youY + state.paddleH/2)) / (state.paddleH/2);
      const speed = Math.min(Math.hypot(state.ballVX,state.ballVY) * 1.06, 11 * state.speedMult);
      const angle = rel * 0.9;
      state.ballVX = Math.abs(speed * Math.cos(angle));
      state.ballVY = speed * Math.sin(angle);
      state.ballX = 26 + state.paddleW + 1;
    }
    if (state.ballX >= W-26-state.paddleW && state.ballX < W-20 &&
        state.ballY > state.cpuY && state.ballY < state.cpuY + state.paddleH && state.ballVX > 0){
      const rel = (state.ballY - (state.cpuY + state.paddleH/2)) / (state.paddleH/2);
      const speed = Math.min(Math.hypot(state.ballVX,state.ballVY) * 1.06, 11 * state.speedMult);
      const angle = rel * 0.9;
      state.ballVX = -Math.abs(speed * Math.cos(angle));
      state.ballVY = speed * Math.sin(angle);
      state.ballX = W-26-state.paddleW - 1;
    }

    if (state.ballX < 0){
      state.cpuScore++; el.scoreCpu.textContent = state.cpuScore;
      if (!checkGameOver()) resetBall(1);
    } else if (state.ballX > W){
      state.youScore++; el.scoreYou.textContent = state.youScore;
      if (!checkGameOver()) resetBall(-1);
    }
  }

  function checkGameOver(){
    if (state.youScore >= 7 || state.cpuScore >= 7){
      state.running = false;
      const won = state.youScore > state.cpuScore;
      el.overlayTitle.textContent = won ? 'WYGRANA!' : 'PRZEGRANA';
      el.btnStart.textContent = 'Zagraj ponownie';
      el.btnStart.disabled = !controllerConnected;
      showOverlay();
      return true;
    }
    return false;
  }

  function draw(){
    ctx.fillStyle = '#0A120D';
    ctx.fillRect(0,0,W,H);
    ctx.strokeStyle = 'rgba(53,255,110,0.25)';
    ctx.setLineDash([8,10]); ctx.lineWidth = 3;
    ctx.beginPath(); ctx.moveTo(W/2,0); ctx.lineTo(W/2,H); ctx.stroke();
    ctx.setLineDash([]);

    ctx.fillStyle = '#35FF6E'; ctx.shadowColor = '#35FF6E'; ctx.shadowBlur = 14;
    ctx.fillRect(20, state.youY, state.paddleW, state.paddleH);

    ctx.fillStyle = '#FFB000'; ctx.shadowColor = '#FFB000'; ctx.shadowBlur = 14;
    ctx.fillRect(W-20-state.paddleW, state.cpuY, state.paddleW, state.paddleH);

    ctx.fillStyle = '#EAFFF0'; ctx.shadowColor = '#EAFFF0'; ctx.shadowBlur = 10;
    ctx.beginPath(); ctx.arc(state.ballX, state.ballY, 7, 0, Math.PI*2); ctx.fill();
    ctx.shadowBlur = 0;
  }

  function loop(){
    if (state.running){ updateYouPaddle(); updateCpuPaddle(); updateBall(); }
    draw();
    requestAnimationFrame(loop);
  }

  state.youY = H/2 - state.paddleH/2;
  state.cpuY = H/2 - state.paddleH/2;
  draw();
  loop();
})();
</script>
</body>
</html>
